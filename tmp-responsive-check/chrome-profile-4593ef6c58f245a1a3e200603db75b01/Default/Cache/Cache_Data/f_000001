/* Dark teal palette requested: #041b45 / #052552 / #009299 / #00b8c1. */
:root {
  --primary: #009299;
  --secondary: #00b8c1;
  --white: #ffffff;
  --ink: #ffffff;
  --muted: #a3a3a3;
  --line: rgba(255, 255, 255, 0.14);
  --soft: rgba(255, 255, 255, 0.06);
  --soft-blue: rgba(0, 184, 193, 0.12);
  --deep: #041b45;
  --surface: #052552;
  --surface-high: #073064;
  --danger: #ef4444;
  --danger-strong: #e74c3c;
  --shadow: 0 20px 56px rgba(0, 0, 0, 0.32);
}

html,
body,
main {
  color: var(--ink);
  background: var(--deep);
}

body {
  background:
    radial-gradient(circle at 18% 8%, rgba(0, 184, 193, 0.12), transparent 28rem),
    radial-gradient(circle at 86% 18%, rgba(0, 146, 153, 0.1), transparent 30rem),
    var(--deep);
}

.site-header {
  color: var(--white);
  background: rgba(4, 27, 69, 0.9);
  border-bottom-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 16px 44px rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(14px) saturate(135%);
  -webkit-backdrop-filter: blur(14px) saturate(135%);
}

.site-header.is-scrolled {
  background: rgba(4, 27, 69, 0.72);
  border-bottom-color: rgba(0, 184, 193, 0.24);
  box-shadow: 0 18px 52px rgba(0, 0, 0, 0.34);
}

.brand,
.site-header.is-scrolled .brand {
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(255, 255, 255, 0.26);
}

.desktop-nav a {
  color: rgba(255, 255, 255, 0.72);
}

.desktop-nav a:hover,
.desktop-nav a[aria-current="page"] {
  color: var(--white);
  border-color: var(--secondary);
}

.mobile-nav {
  background: rgba(4, 27, 69, 0.96);
  border-bottom-color: rgba(255, 255, 255, 0.12);
}

.mobile-nav a,
.mobile-nav a[aria-current="page"],
.mobile-nav a:hover {
  color: var(--white);
}

.icon-button,
.site-header.is-scrolled .icon-button {
  color: var(--white);
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.18);
}

.button.primary,
.header-actions .button.primary,
.site-header.is-scrolled .header-actions .button.primary {
  color: var(--deep);
  background: var(--primary);
  border-color: var(--primary);
  box-shadow: 0 14px 34px rgba(0, 146, 153, 0.24);
}

.button.primary:hover,
.header-actions .button.primary:hover {
  color: var(--deep);
  background: var(--secondary);
  border-color: var(--secondary);
}

.button.secondary {
  color: var(--white);
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(0, 184, 193, 0.52);
}

.button.secondary:hover {
  color: var(--deep);
  background: var(--secondary);
  border-color: var(--secondary);
}

.hero {
  background-image:
    linear-gradient(90deg, rgba(4,27,69,0.94), rgba(4,27,69,0.78) 44%, rgba(4,27,69,0.34)),
    linear-gradient(to bottom, rgba(4,27,69,0.16), rgba(4,27,69,0.82)),
    url("products/hero-productos.jpg");
}

.hero-copy h1,
.hero-copy .lead,
.hero-kicker,
.page-hero h1,
.page-hero .lead,
.section-header h2,
.section-copy h2,
h1,
h2,
h3,
.product-body h3,
.service-card h3,
.info-card h3,
.catalog-cta h3,
.story-copy h2 {
  color: var(--white);
}

.hero-copy h1 span,
.eyebrow,
.eyebrow.light,
.service-card > span,
.service-card strong,
.detail-list strong,
label,
.contact-card strong,
.story-copy .eyebrow {
  color: var(--secondary);
}

.eyebrow::before,
.hero .eyebrow::before {
  background: var(--secondary);
}

.lead,
.value-card p,
.info-card p,
.service-card p,
.catalog-cta p,
.site-footer p,
.detail-list,
.product-body .meta,
.story-copy p,
.section-copy p,
.footer-contact p,
.footer-contact a,
.footer-nav a {
  color: var(--muted);
}

.section,
.featured-section,
.value-section,
.services-section,
.about-story-section,
.contact-grid {
  color: var(--ink);
  background:
    linear-gradient(180deg, rgba(5,37,82,0.66), rgba(4,27,69,0.98));
  border-color: rgba(255, 255, 255, 0.1);
}

.intro-band,
.catalog-cta,
.service-cta,
.metadata-strip {
  background: linear-gradient(135deg, #052552 0%, #041b45 58%, rgba(0,146,153,0.5) 100%);
  border-color: rgba(0, 184, 193, 0.18);
}

.metadata-grid strong,
.metadata-grid span,
.metadata-grid .material-symbols-outlined {
  color: var(--white);
}

.metadata-grid .material-symbols-outlined {
  background: rgba(0, 184, 193, 0.18);
  border: 1px solid rgba(0, 184, 193, 0.34);
}

.value-card,
.info-card,
.service-card,
.product-card,
.contact-card,
form,
.catalog-tools,
.story-panel,
.plant-photo,
.catalog-empty {
  color: var(--ink);
  background:
    linear-gradient(145deg, rgba(5,37,82,0.98), rgba(5,37,82,0.78));
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.24);
}

.value-card:hover,
.info-card:hover,
.service-card:hover,
.product-card:hover,
.story-panel:hover,
.plant-photo:hover {
  border-color: rgba(0, 184, 193, 0.42);
  box-shadow: 0 24px 62px rgba(0, 0, 0, 0.34);
}

.story-panel,
.story-panel.reverse,
.story-panel--vision,
.service-card,
.product-card,
.contact-card,
form {
  border-left-color: var(--primary);
  border-top-color: rgba(0, 184, 193, 0.38);
}

.product-media,
.modal-image,
.filter-button,
.catalog-search,
input,
textarea {
  color: var(--white);
  background: rgba(4, 27, 69, 0.62);
  border-color: rgba(255, 255, 255, 0.16);
}

input,
textarea {
  border-bottom-color: rgba(255, 255, 255, 0.24);
}

input:focus,
textarea:focus {
  border-bottom-color: var(--secondary);
}

input::placeholder,
textarea::placeholder {
  color: rgba(255, 255, 255, 0.46);
}

.catalog-search:focus-within {
  border-color: var(--secondary);
  box-shadow: 0 0 0 4px rgba(0, 184, 193, 0.12);
}

.pill,
.value-card .material-symbols-outlined,
.filter-button.active,
.filter-button:hover {
  color: var(--deep);
  background: var(--secondary);
  border-color: var(--secondary);
}

.filter-button {
  color: rgba(255, 255, 255, 0.78);
}

.page-hero {
  color: var(--white);
}

.page-hero::before {
  background:
    linear-gradient(90deg, rgba(4,27,69,0.95), rgba(4,27,69,0.74) 48%, rgba(4,27,69,0.32)),
    linear-gradient(to bottom, rgba(4,27,69,0.1), rgba(4,27,69,0.84));
}

.plant-photo figcaption {
  color: var(--deep);
  background: rgba(0, 184, 193, 0.92);
  border-color: rgba(255, 255, 255, 0.18);
}

.site-footer {
  background: linear-gradient(135deg, #041b45 0%, #052552 72%, rgba(0,146,153,0.34) 100%);
  border-top: 1px solid rgba(0, 184, 193, 0.16);
}

.footer-whatsapp {
  color: var(--deep);
  background: var(--primary);
  border-color: var(--primary);
}

.footer-whatsapp:hover,
.footer-whatsapp:focus-visible {
  color: var(--deep);
  background: var(--secondary);
  border-color: var(--secondary);
}

.footer-whatsapp .material-symbols-outlined,
.footer-whatsapp:hover .material-symbols-outlined,
.footer-whatsapp:focus-visible .material-symbols-outlined {
  color: var(--deep);
}

.modal-backdrop {
  background: rgba(4, 27, 69, 0.82);
}

.modal-dialog,
.modal-close {
  color: var(--white);
  background: var(--surface);
  border-color: rgba(255, 255, 255, 0.14);
}

.form-status.show,
.catalog-empty {
  border-left: 4px solid var(--danger);
}

.map {
  border-color: rgba(0, 184, 193, 0.24);
  filter: saturate(0.95) contrast(0.96);
}

/* Image and logo refinements requested after dark palette. */
.brand,
.site-header.is-scrolled .brand {
  background: transparent;
  border-color: transparent;
  box-shadow: none;
}

.brand-isotipo {
  width: 54px;
  height: 54px;
  object-fit: contain;
}

.brand-texto {
  width: min(174px, 36vw);
  height: auto;
  object-fit: contain;
}

.site-footer .footer-logo.footer-logo--white {
  width: min(230px, 100%);
  height: 74px;
  object-fit: contain;
  object-position: left center;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.hero {
  position: relative;
  overflow: hidden;
  background: var(--deep);
}

.hero-slideshow,
.hero-slide {
  position: absolute;
  inset: 0;
}

.hero-slideshow {
  z-index: 0;
  pointer-events: none;
}

.hero-slide {
  opacity: 0;
  background-size: cover;
  background-position: center;
  transform: scale(1.04);
  animation: heroSlideShow 28s infinite;
}

.hero-slide::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(4,27,69,0.96), rgba(4,27,69,0.78) 44%, rgba(4,27,69,0.36)),
    linear-gradient(to bottom, rgba(4,27,69,0.1), rgba(4,27,69,0.84));
}

.hero-slide--plant {
  background-image: url("plant/plant-quality.jpg");
  animation-delay: 0s;
}

.hero-slide--production {
  background-image: url("plant/plant-production.jpg");
  animation-delay: 7s;
}

.hero-slide--market {
  background-image: url("generated/supermarket-aisle.jpg");
  animation-delay: 14s;
}

.hero-slide--trade {
  background-image: url("generated/import-agent.jpg");
  animation-delay: 21s;
}

@keyframes heroSlideShow {
  0%, 18% {
    opacity: 1;
    transform: scale(1);
  }
  25%, 100% {
    opacity: 0;
    transform: scale(1.04);
  }
}

.hero-grid {
  position: relative;
  z-index: 1;
}

.hero-visual img {
  object-position: center;
}

.page-hero--nosotros {
  background-image: url("generated/nicaragua-landscape.jpg");
}

.page-hero--catalogo {
  background-image: url("generated/supermarket-aisle.jpg");
}

.page-hero--servicios {
  background-image: url("plant/plant-production.jpg");
}

.page-hero--contacto {
  background-image: url("generated/import-agent.jpg");
}

.story-panel,
.story-panel.reverse,
.story-panel--vision {
  background:
    linear-gradient(145deg, rgba(5,37,82,0.98), rgba(5,37,82,0.8));
  border-left-color: var(--primary);
}

.story-panel img {
  object-position: center;
}

.story-panel.reverse .story-copy {
  order: 2;
}

.story-panel.reverse img {
  order: 1;
}

.story-panel--vision .story-copy {
  order: 1;
}

.story-panel--vision img {
  order: 2;
}

@media (max-width: 980px) {
  .brand-isotipo {
    width: 48px;
    height: 48px;
  }

  .brand-texto {
    width: min(158px, 42vw);
  }

  .story-panel.reverse .story-copy,
  .story-panel.reverse img,
  .story-panel--vision .story-copy,
  .story-panel--vision img {
    order: initial;
  }
}

@media (max-width: 520px) {
  .hero-copy {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .hero-copy h1 {
    max-width: 100%;
    font-size: clamp(2.35rem, 12vw, 3rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .hero-actions {
    width: 100%;
  }

  .hero-actions .button {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    justify-content: center;
    padding-inline: 14px;
    font-size: 0.68rem;
    letter-spacing: 0.11em;
    white-space: normal;
    text-align: center;
  }
}
