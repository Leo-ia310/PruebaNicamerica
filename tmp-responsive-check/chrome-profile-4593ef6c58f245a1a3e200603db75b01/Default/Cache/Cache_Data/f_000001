  height: 172px;
  object-fit: cover;
  display: block;
}
.value-card .material-symbols-outlined {
  width: 56px;
  height: 56px;
  display: grid;
  place-items: center;
  margin: -28px 24px 18px;
  border: 4px solid var(--white);
  border-radius: 50%;
  box-shadow: 0 14px 26px rgba(0,46,93,0.18);
}
.value-card h2,
.value-card p {
  padding-inline: 24px;
}
.value-card:hover {
  transform: translateY(-9px);
}

.product-card {
  border-radius: 8px;
  overflow: hidden;
  transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease;
}
.product-card:hover {
  transform: translateY(-8px);
}
.product-card:hover .product-media img {
  transform: scale(1.075);
}

.page-hero {
  position: relative;
  isolation: isolate;
  min-height: 440px;
  display: grid;
  align-items: end;
  padding-top: 160px;
  padding-bottom: 74px;
  color: var(--primary);
  background-size: cover;
  background-position: center;
  overflow: hidden;
}
.page-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.94), rgba(255,255,255,0.66) 48%, rgba(0,46,93,0.18)),
    linear-gradient(to bottom, rgba(255,255,255,0.2), rgba(255,255,255,0.78));
}
.page-hero--nosotros {
  background-image: url("products/hero-productos.jpg");
}
.page-hero--catalogo {
  background-image: url("products/briomol-condimento-achiote.jpg");
}
.page-hero--servicios {
  background-image: url("products/queso-morolique-cubos.jpg");
}
.page-hero--contacto {
  background-image: url("products/rojita-3-litros.jpg");
}
.page-hero .section-copy {
  max-width: 780px;
}

.story-stack {
  display: grid;
  gap: 34px;
}
.story-panel {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
  gap: clamp(24px, 4vw, 56px);
  align-items: center;
  padding: clamp(22px, 4vw, 42px);
  background:
    linear-gradient(135deg, rgba(0,46,93,0.065), rgba(255,255,255,0.98));
  border: 1px solid var(--line);
  border-radius: 8px;
}
.story-panel.reverse .story-copy {
  order: 2;
}
.story-panel.reverse img {
  order: 1;
}
.story-panel img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 8px;
  box-shadow: 0 20px 48px rgba(0,46,93,0.16);
}
.story-copy h2 {
  margin: 0 0 16px;
  font-size: clamp(2rem, 4vw, 3.6rem);
  line-height: 1;
}
.story-copy p {
  margin: 0;
  color: var(--muted);
}

.catalog-tools {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 390px);
  gap: 20px;
  align-items: end;
  margin-bottom: 34px;
  padding: 24px;
  background: linear-gradient(135deg, rgba(0,46,93,0.06), rgba(255,255,255,0.95));
  border: 1px solid var(--line);
  border-radius: 8px;
}
.catalog-tools .eyebrow {
  margin-bottom: 12px;
}
.catalog-search {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 10px;
  padding: 0 16px;
  min-height: 56px;
  color: var(--primary);
  background: var(--white);
  border: 1px solid rgba(0,46,93,0.24);
  border-radius: 8px;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.66);
}
.catalog-search input {
  min-width: 0;
  border: 0;
  padding: 0;
  background: transparent;
}
.catalog-search:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(0,46,93,0.1);
}
.catalog-empty {
  grid-column: 1 / -1;
  padding: 26px;
  color: var(--primary);
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 8px;
}

.service-card {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(0,46,93,0.055), rgba(255,255,255,0.98));
  border-radius: 8px;
  transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease;
}
.service-card::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 5px;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 260ms ease;
}
.service-card:hover {
  transform: translateY(-8px);
}
.service-card:hover::after {
  transform: scaleX(1);
}
.service-cta {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: center;
  margin-top: 38px;
  padding: clamp(24px, 4vw, 42px);
  color: var(--white);
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  border-radius: 8px;
}
.service-cta h2,
.service-cta p {
  color: var(--white);
}
.service-cta h2 {
  margin: 0 0 10px;
  font-size: clamp(1.8rem, 3.8vw, 3.2rem);
  line-height: 1.02;
}
.service-cta p {
  margin: 0;
  max-width: 720px;
}

.contact-grid {
  padding: clamp(20px, 3vw, 32px);
  border: 1px solid var(--line);
  border-radius: 8px;
}
.contact-card,
form {
  border-radius: 8px;
  box-shadow: 0 18px 40px rgba(0,46,93,0.1);
}
input,
textarea {
  padding: 13px 0 12px;
  border-bottom-width: 2px;
}
input::placeholder,
textarea::placeholder {
  color: rgba(0,46,93,0.42);
}
textarea {
  min-height: 150px;
}

.site-footer {
  background:
    linear-gradient(135deg, #002E5D 0%, #003366 58%, #001d3d 100%);
}
.footer-grid {
  gap: clamp(28px, 5vw, 74px);
}
@media (max-width: 1080px) {
  .site-header .nav-wrap {
    grid-template-columns: auto 1fr auto;
  }
  .desktop-nav {
    min-width: 0;
  }
}

@media (max-width: 980px) {
  .site-header .nav-wrap {
    display: flex;
    min-height: 82px;
  }
  .desktop-nav {
    display: none;
  }
  .header-actions .button {
    display: none;
  }
  .metadata-grid div {
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,0.18);
  }
  .story-panel,
  .story-panel.reverse {
    grid-template-columns: 1fr;
  }
  .story-panel.reverse .story-copy,
  .story-panel.reverse img {
    order: initial;
  }
  .catalog-tools {
    grid-template-columns: 1fr;
  }
  .service-cta {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 640px) {
  .page-hero {
    min-height: 390px;
    padding-top: 122px;
    padding-bottom: 48px;
  }
  .metadata-grid div {
    min-height: 76px;
    padding-inline: 14px;
  }
  .value-card img {
    height: 150px;
  }
  .story-panel,
  .catalog-tools,
  .contact-grid {
    padding: 18px;
  }
}

