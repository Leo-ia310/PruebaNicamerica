:root {
  --primary: #002E5D;
  --secondary: #003366;
  --white: #FFFFFF;
  --ink: #10243A;
  --muted: #60758B;
  --line: rgba(0, 46, 93, 0.14);
  --soft: #F5F8FB;
  --soft-blue: #EAF1F8;
  --shadow: 0 22px 70px rgba(0, 46, 93, 0.14);
  --radius: 8px;
  --header: 96px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: "Plus Jakarta Sans", Arial, sans-serif;
  color: var(--ink);
  background: var(--white);
  line-height: 1.65;
}
body.modal-open { overflow: hidden; }
img { display: block; max-width: 100%; }
a { color: inherit; }
button, input, textarea { font: inherit; }
:focus-visible { outline: 3px solid rgba(0, 46, 93, 0.34); outline-offset: 3px; }

.container {
  width: min(1180px, calc(100% - 32px));
  margin-inline: auto;
}
.section {
  padding: clamp(72px, 9vw, 124px) 0;
  scroll-margin-top: calc(var(--header) + 22px);
}
.section-header {
  display: grid;
  gap: 18px;
  margin-bottom: 42px;
}
.section-copy {
  display: grid;
  gap: 22px;
  min-width: 0;
}
.section-action { margin-top: 28px; }
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--primary);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.eyebrow::before {
  content: "";
  width: 34px;
  height: 2px;
  background: currentColor;
}
.eyebrow.light { color: var(--white); }
h1, h2, h3 {
  font-family: "Playfair Display", Georgia, serif;
  line-height: 1.08;
  color: var(--primary);
  margin: 0;
}
h1 { font-size: clamp(2.45rem, 6vw, 5.7rem); letter-spacing: 0; }
h2 { font-size: clamp(2rem, 4vw, 3.65rem); }
h3 { font-size: clamp(1.3rem, 2.2vw, 1.8rem); }
p { margin: 0; }
.lead {
  color: var(--muted);
  font-size: clamp(1rem, 1.45vw, 1.18rem);
  max-width: 760px;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  height: var(--header);
  background: rgba(255, 255, 255, 0.93);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--line);
}
.nav-wrap {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  min-width: 0;
  padding: 4px 14px;
}
.brand-isotipo {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  object-fit: contain;
}
.brand-texto {
  height: clamp(46px, 6.8vw, 72px);
  width: auto;
  max-width: 340px;
  object-fit: contain;
  object-position: left center;
}
.brand-mark {
  width: 46px;
  height: 46px;
  border-radius: var(--radius);
  display: grid;
  place-items: center;
  color: var(--white);
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  box-shadow: 0 10px 26px rgba(0, 46, 93, 0.22);
  font-weight: 900;
  letter-spacing: -0.05em;
}
.brand strong {
  display: block;
  color: var(--primary);
  line-height: 1.05;
}
.brand small {
  display: block;
  color: var(--muted);
  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.desktop-nav {
  display: flex;
  align-items: center;
  gap: 26px;
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 800;
}
.desktop-nav a {
  text-decoration: none;
  transition: color 180ms ease;
}
.desktop-nav a:hover { color: var(--primary); }
.desktop-nav a[aria-current="page"] {
  color: var(--primary);
}
.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 48px;
  padding: 0 20px;
  border: 1px solid var(--primary);
  border-radius: var(--radius);
  text-decoration: none;
  font-weight: 850;
  cursor: pointer;
  transition: transform 180ms ease, background 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}
.button:hover { transform: translateY(-2px); }
.button.primary {
  color: var(--white);
  background: var(--primary);
  box-shadow: 0 12px 30px rgba(0, 46, 93, 0.22);
}
.button.primary:hover { background: var(--secondary); }
.button.secondary {
  color: var(--primary);
  background: var(--white);
}
.button.secondary:hover { background: var(--soft-blue); }
.button.compact { min-height: 44px; padding: 0 16px; }
.icon-button {
  display: none;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  color: var(--primary);
  background: var(--white);
  cursor: pointer;
}
.mobile-nav {
  display: none;
  position: fixed;
  inset: var(--header) 0 auto 0;
  padding: 18px 16px 22px;
  background: var(--white);
  border-bottom: 1px solid var(--line);
  box-shadow: var(--shadow);
}
.mobile-nav.open { display: grid; }
.mobile-nav a {
  padding: 14px 4px;
  color: var(--primary);
  font-weight: 850;
  text-decoration: none;
  border-bottom: 1px solid var(--line);
}
.mobile-nav a[aria-current="page"] { color: var(--secondary); }

.hero {
  min-height: calc(100vh - var(--header));
  display: grid;
  align-items: center;
  padding: clamp(54px, 7vw, 96px) 0;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.96), rgba(255,255,255,0.9) 50%, rgba(234,241,248,0.72)),
    radial-gradient(circle at 76% 26%, rgba(0, 51, 102, 0.14), transparent 34%);
}
.page-hero {
  padding: clamp(86px, 11vw, 150px) 0 clamp(54px, 7vw, 90px);
  background:
    linear-gradient(90deg, rgba(255,255,255,0.98), rgba(255,255,255,0.92) 54%, rgba(234,241,248,0.76)),
    radial-gradient(circle at 76% 18%, rgba(0, 51, 102, 0.12), transparent 32%);
  border-bottom: 1px solid var(--line);
}
.page-hero h1 {
  max-width: 980px;
  font-size: clamp(2.45rem, 5.4vw, 5rem);
}
.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.02fr) minmax(320px, 0.85fr);
  gap: clamp(36px, 7vw, 86px);
  align-items: center;
}
.hero-copy {
  display: grid;
  gap: 26px;
  max-width: 790px;
}
.hero-copy h1 span { color: var(--secondary); }
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 8px;
}
.hero-visual {
  position: relative;
  min-height: 560px;
  margin: 0;
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--soft);
  box-shadow: var(--shadow);
  isolation: isolate;
}
.hero-visual img {
  width: 100%;
  height: 100%;
  min-height: 560px;
  object-fit: cover;
  object-position: center;
  transition: transform 700ms ease;
}
.hero-visual:hover img { transform: scale(1.035); }
.hero-visual::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, transparent 35%, rgba(0, 46, 93, 0.86));
}
.hero-visual figcaption {
  position: absolute;
  left: 22px;
  right: 22px;
  bottom: 22px;
  z-index: 2;
  display: grid;
  gap: 8px;
  color: var(--white);
}
.hero-visual strong { font-size: 1.15rem; }

.value-section { padding-top: clamp(54px, 7vw, 86px); }
.value-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.value-card,
.info-card,
.service-card,
.product-card,
.contact-card,
form,
.catalog-cta {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--white);
}
.value-card {
  display: grid;
  gap: 14px;
  padding: 26px;
  box-shadow: 0 12px 38px rgba(0, 46, 93, 0.06);
}
.value-card .material-symbols-outlined {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: var(--radius);
  color: var(--white);
  background: var(--primary);
  font-size: 26px;
}
.value-card h2 {
  font-family: "Plus Jakarta Sans", Arial, sans-serif;
  font-size: 1.1rem;
}
.value-card p,
.info-card p,
.service-card p,
.catalog-cta p { color: var(--muted); }

.intro-band {
  color: var(--white);
  background: var(--primary);
}
.intro-band h2 { color: var(--white); }
.intro-band p {
  max-width: 760px;
  color: rgba(255,255,255,0.86);
  font-size: clamp(1rem, 1.4vw, 1.16rem);
}
.intro-layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 54px;
  align-items: center;
}
.intro-layout > * { min-width: 0; }
.plant-placeholder {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 270px;
  aspect-ratio: 16 / 10;
  display: grid;
  place-items: center;
  padding: 30px;
  text-align: center;
  color: var(--primary);
  border: 1px dashed rgba(0, 46, 93, 0.32);
  border-radius: var(--radius);
  background:
    linear-gradient(135deg, rgba(0,46,93,0.08), rgba(0,51,102,0.03)),
    repeating-linear-gradient(45deg, rgba(0,46,93,0.05) 0 12px, transparent 12px 24px);
}
.plant-placeholder.dark {
  min-height: 360px;
  color: var(--white);
  border-color: rgba(255,255,255,0.48);
  background:
    linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.04)),
    repeating-linear-gradient(45deg, rgba(255,255,255,0.08) 0 12px, transparent 12px 24px);
}
.plant-placeholder strong {
  display: block;
  margin-bottom: 10px;
  font-size: 1.25rem;
  letter-spacing: 0.08em;
}
.plant-placeholder span {
  display: block;
  max-width: 480px;
  overflow-wrap: anywhere;
  opacity: 0.84;
}

.about-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 22px;
}
.info-card {
  display: grid;
  gap: 14px;
  padding: 30px;
  background: linear-gradient(180deg, var(--white), var(--soft));
}
.info-card.wide { grid-column: 1 / -1; }
.info-card h3,
.service-card h3,
.catalog-cta h3 {
  font-family: "Plus Jakarta Sans", Arial, sans-serif;
  color: var(--primary);
  font-size: 1.1rem;
}

.featured-section,
.services-section {
  background: var(--soft);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}
.product-card {
  padding: 0;
  overflow: hidden;
  text-align: left;
  cursor: pointer;
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
}
.product-card:hover {
  transform: translateY(-5px);
  border-color: rgba(0, 46, 93, 0.28);
  box-shadow: var(--shadow);
}
.product-media {
  aspect-ratio: 4 / 3;
  display: grid;
  place-items: center;
  padding: 16px;
  overflow: hidden;
  background: var(--soft);
}
.product-media img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 300ms ease;
}
.product-card:hover img { transform: scale(1.04); }
.product-body {
  display: grid;
  gap: 8px;
  padding: 20px;
}
.product-body h3 {
  font-family: "Plus Jakarta Sans", Arial, sans-serif;
  color: var(--ink);
  font-size: 1rem;
  line-height: 1.3;
}
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  color: var(--muted);
  font-size: 0.83rem;
  font-weight: 700;
}
.pill {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-height: 28px;
  padding: 4px 10px;
  border-radius: 999px;
  color: var(--primary);
  background: var(--soft-blue);
  font-size: 0.78rem;
  font-weight: 850;
}
.filter-bar {
  max-width: 100%;
  min-width: 0;
  display: flex;
  gap: 10px;
  padding: 4px 0 18px;
  margin-bottom: 18px;
  overflow-x: auto;
  scrollbar-width: thin;
}
.filter-button {
  min-height: 42px;
  padding: 0 16px;
  white-space: nowrap;
  color: var(--primary);
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 999px;
  font-weight: 850;
  cursor: pointer;
  transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
}
.filter-button.active,
.filter-button:hover {
  color: var(--white);
  background: var(--primary);
  border-color: var(--primary);
}
.catalog-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-top: 34px;
  padding: 28px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
}
.catalog-cta h3,
.catalog-cta p { color: var(--white); }
.catalog-cta p { opacity: 0.86; }
.catalog-cta .button {
  flex: 0 0 auto;
  color: var(--primary);
  background: var(--white);
  border-color: var(--white);
  box-shadow: none;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.service-card {
  display: grid;
  gap: 16px;
  padding: 28px;
}
.service-card > span {
  color: var(--secondary);
  font-weight: 900;
  letter-spacing: 0.14em;
}
.service-card strong {
  color: var(--primary);
  font-size: 0.92rem;
}
.placeholder-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
  margin-top: 34px;
}

.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.86fr) minmax(320px, 1.14fr);
  gap: 34px;
  align-items: start;
}
.contact-card {
  display: grid;
  gap: 22px;
  padding: 28px;
  background: var(--soft);
}
.contact-card h3 {
  font-family: "Plus Jakarta Sans", Arial, sans-serif;
  color: var(--primary);
}
.contact-card strong {
  display: block;
  color: var(--primary);
  margin-bottom: 4px;
}
.contact-card p,
.contact-card a { color: var(--muted); }
.contact-card a {
  display: block;
  width: fit-content;
  font-weight: 800;
  text-decoration: none;
}
.contact-card a:hover { color: var(--primary); text-decoration: underline; }
.contact-main {
  display: grid;
  gap: 26px;
}
form {
  display: grid;
  gap: 18px;
  padding: clamp(22px, 4vw, 34px);
  box-shadow: 0 16px 48px rgba(0, 46, 93, 0.08);
}
.field-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
label {
  display: grid;
  gap: 8px;
  color: var(--primary);
  font-size: 0.9rem;
  font-weight: 850;
}
input,
textarea {
  width: 100%;
  padding: 13px 14px;
  color: var(--ink);
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}
textarea {
  min-height: 150px;
  resize: vertical;
}
.form-note {
  padding: 12px 14px;
  color: var(--muted);
  background: var(--soft);
  border-left: 4px solid var(--primary);
  font-size: 0.92rem;
}
.form-status {
  display: none;
  color: var(--primary);
  font-weight: 800;
}
.form-status.show { display: block; }
.map {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 260px;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius);
}
.map iframe {
  width: 100%;
  height: 100%;
  display: block;
  border: 0;
}

.site-footer {
  padding: 56px 0 28px;
  color: var(--white);
  background: var(--primary);
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.3fr 0.8fr 1fr 1fr;
  gap: 34px;
  padding-bottom: 34px;
  border-bottom: 1px solid rgba(255,255,255,0.18);
}
.site-footer h2,
.site-footer strong { color: var(--white); }
.site-footer h2 { font-size: 2rem; }
.footer-logo {
  width: min(310px, 100%);
  height: auto;
  padding: 10px 14px;
  margin-bottom: 18px;
}
.site-footer p,
.site-footer a {
  color: rgba(255,255,255,0.78);
}
.site-footer a {
  display: block;
  margin-top: 8px;
  text-decoration: none;
}
.site-footer a:hover {
  color: var(--white);
  text-decoration: underline;
}
.copyright {
  padding-top: 22px;
  color: rgba(255,255,255,0.7);
  font-size: 0.9rem;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 18px;
}
.modal.open { display: flex; }
.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(2, 19, 38, 0.72);
  backdrop-filter: blur(6px);
}
.modal-dialog {
  position: relative;
  width: min(980px, 100%);
  max-height: min(820px, calc(100vh - 36px));
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: auto;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: 0 28px 90px rgba(0,0,0,0.28);
  animation: modalIn 180ms ease-out;
}
@keyframes modalIn {
  from { transform: translateY(12px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 3;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  color: var(--primary);
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  cursor: pointer;
}
.modal-image {
  min-height: 450px;
  display: grid;
  place-items: center;
  padding: 20px;
  background: var(--soft);
}
.modal-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.modal-content {
  display: grid;
  gap: 18px;
  align-content: center;
  padding: clamp(24px, 4vw, 42px);
}
.detail-list {
  display: grid;
  gap: 9px;
  color: var(--muted);
}
.detail-list div {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--line);
}
.detail-list strong { color: var(--primary); }

.reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 560ms ease, transform 560ms ease;
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 980px) {
  .desktop-nav,
  .header-actions .button { display: none; }
  .icon-button { display: grid; }
  .hero-grid,
  .intro-layout,
  .contact-grid,
  .footer-grid { grid-template-columns: 1fr; }
  .hero-visual,
  .hero-visual img { min-height: 430px; }
  .value-grid,
  .product-grid,
  .services-grid { grid-template-columns: repeat(2, 1fr); }
  .placeholder-grid { grid-template-columns: 1fr; }
  .modal-dialog { grid-template-columns: 1fr; }
  .modal-image { min-height: 330px; }
}

@media (max-width: 640px) {
  :root { --header: 72px; }
  .container { width: min(100% - 24px, 1180px); }
  .brand { padding: 5px 8px; }
  .brand-logo {
    width: min(210px, 58vw);
    height: 44px;
  }
  .brand-mark { width: 42px; height: 42px; }
  .brand strong { font-size: 0.94rem; }
  .value-grid,
  .product-grid,
  .services-grid,
  .about-grid,
  .field-grid { grid-template-columns: 1fr; }
  .info-card.wide { grid-column: auto; }
  .hero { padding-top: 38px; }
  .hero-actions .button { width: 100%; }
  .hero-visual,
  .hero-visual img { min-height: 360px; }
  .plant-placeholder {
    min-height: 240px;
    aspect-ratio: auto;
    padding: 22px;
  }
  .plant-placeholder.dark { min-height: 280px; }
  .map {
    min-height: 0;
    height: 260px;
    aspect-ratio: auto;
  }
  .catalog-cta {
    display: grid;
    align-items: start;
  }
  .catalog-cta .button { width: 100%; }
  .modal { padding: 10px; }
  .modal-content { padding: 22px; }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* Visual alignment with the supplied Pagina4 template. */
:root {
  --primary: #002E5D;
  --secondary: #003366;
  --white: #e2e3e0;
  --ink: #e2e3e0;
  --muted: #d1c5b8;
  --line: rgba(226, 195, 153, 0.18);
  --soft: #1a1c1b;
  --soft-blue: #282a29;
  --deep: #0d0f0e;
  --surface: #121413;
  --surface-high: #1e201f;
  --shadow: 0 28px 80px rgba(0, 0, 0, 0.48);
  --radius: 4px;
  --header: 80px;
}

html { background: var(--deep); }
body {
  color: var(--ink);
  background: var(--deep);
  font-weight: 400;
}
.container { width: min(88rem, calc(100% - 32px)); }
main {
  padding-top: var(--header);
  background: var(--deep);
}

.site-header {
  position: fixed;
  height: var(--header);
  background: rgba(13, 15, 14, 0.82);
  border-bottom: 1px solid rgba(226, 195, 153, 0.2);
  box-shadow: 0 12px 40px -8px rgba(0,0,0,0.75), 0 0 1px 1px rgba(197,168,128,0.15);
}
.brand-mark {
  color: #281800;
  background: var(--primary);
  box-shadow: none;
}
.brand strong {
  color: var(--primary);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.brand small {
  color: #998f83;
  letter-spacing: 0.25em;
}
.desktop-nav {
  gap: clamp(18px, 2vw, 32px);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
}
.desktop-nav a {
  color: var(--muted);
  padding: 5px 0;
  border-bottom: 1px solid transparent;
}
.desktop-nav a:hover,
.desktop-nav a[aria-current="page"] {
  color: var(--primary);
  border-color: var(--primary);
}
.mobile-nav {
  background: rgba(13, 15, 14, 0.98);
  border-bottom-color: var(--line);
}
.mobile-nav a { color: var(--muted); }
.mobile-nav a[aria-current="page"],
.mobile-nav a:hover { color: var(--primary); }
.icon-button {
  color: var(--primary);
  background: rgba(30, 32, 31, 0.92);
  border-color: rgba(226, 195, 153, 0.35);
}

.button {
  min-height: 52px;
  border-radius: 0;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-size: 0.76rem;
  box-shadow: none;
}
.button.primary {
  color: var(--deep);
  background: var(--white);
  border-color: var(--white);
}
.button.primary:hover {
  color: #281800;
  background: var(--primary);
}
.button.secondary {
  color: var(--white);
  background: rgba(18,20,19,0.22);
  border-color: rgba(226, 195, 153, 0.4);
}
.button.secondary:hover {
  color: var(--primary);
  background: rgba(30,32,31,0.72);
  border-color: var(--primary);
}

.hero {
  position: relative;
  min-height: 100svh;
  margin-top: calc(var(--header) * -1);
  padding: clamp(112px, 13svh, 136px) 0 clamp(40px, 7svh, 64px);
  align-items: stretch;
  background-image:
    linear-gradient(to top, rgba(13,15,14,0.98), rgba(13,15,14,0.62) 48%, rgba(13,15,14,0.42)),
    radial-gradient(ellipse at center, rgba(18,20,19,0.14), rgba(13,15,14,0.86)),
    url("products/hero-productos.jpg");
  background-size: cover;
  background-position: center;
}
.hero-grid {
  position: relative;
  z-index: 2;
  min-height: calc(100svh - 190px);
  display: grid;
  grid-template-columns: 1fr;
  place-items: center;
}
.hero-copy {
  position: relative;
  z-index: 3;
  width: min(100%, 920px);
  justify-items: center;
  text-align: center;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
}
.hero-copy.reveal {
  opacity: 1;
  transform: none;
}
.hero-copy h1 {
  max-width: 780px;
  color: var(--white);
  font-weight: 400;
  font-size: clamp(2.65rem, 5.7vw, 4.85rem);
  line-height: 1.04;
  filter: drop-shadow(0 14px 28px rgba(0,0,0,0.45));
}
.hero-copy h1 span {
  color: var(--primary);
  font-style: italic;
  font-weight: 400;
}
.hero-copy .lead {
  max-width: 690px;
  color: #f0e7da;
  font-size: clamp(1rem, 1.28vw, 1.14rem);
  font-weight: 300;
  text-shadow: 0 12px 30px rgba(0,0,0,0.9);
}
.hero-kicker {
  color: var(--primary);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  text-shadow: 0 10px 24px rgba(0,0,0,0.72);
}
.hero .eyebrow {
  padding: 7px 20px;
  color: var(--primary);
  background: rgba(13,15,14,0.72);
  border: 1px solid rgba(226, 195, 153, 0.25);
  backdrop-filter: blur(12px);
}
.hero .eyebrow::before {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--primary);
  animation: pulseDot 1.5s infinite;
}
@keyframes pulseDot {
  0%, 100% { opacity: 0.55; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.15); }
}
.hero-actions {
  justify-content: center;
  margin-top: 8px;
}
.hero-visual { display: none; }

.metadata-strip {
  padding: 16px 0;
  color: #998f83;
  background: var(--soft);
  border-block: 1px solid rgba(226, 195, 153, 0.15);
}
.metadata-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px 28px;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.metadata-grid div {
  display: flex;
  align-items: center;
  gap: 8px;
}
.metadata-grid strong { color: var(--primary); }
.metadata-grid span { color: var(--white); }
.status-dot {
  position: relative;
  padding-left: 14px;
}
.status-dot::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: #7bd88f;
  transform: translateY(-50%);
}

.section {
  background: var(--deep);
  border-top: 1px solid rgba(226, 195, 153, 0.08);
}
.value-section,
.featured-section,
.services-section {
  background: var(--soft);
  border-block: 1px solid rgba(226, 195, 153, 0.1);
}
.section-header {
  padding-bottom: 26px;
  border-bottom: 1px solid rgba(226, 195, 153, 0.2);
}
.eyebrow {
  color: var(--primary);
  letter-spacing: 0.25em;
}
.eyebrow::before {
  background: var(--primary);
}
h1, h2, h3 {
  color: var(--white);
  font-weight: 400;
}
.lead,
.value-card p,
.info-card p,
.service-card p,
.catalog-cta p,
.site-footer p,
.form-note,
.detail-list,
.product-body .meta {
  color: var(--muted);
}
.value-card,
.info-card,
.service-card,
.product-card,
.contact-card,
form,
.catalog-cta {
  color: var(--white);
  background: var(--surface);
  border: 1px solid rgba(226, 195, 153, 0.16);
  border-radius: 0;
  box-shadow: none;
}
.value-card,
.info-card,
.service-card {
  padding: clamp(26px, 4vw, 44px);
}
.value-card .material-symbols-outlined {
  color: var(--deep);
  background: var(--primary);
  border-radius: 0;
}
.value-card:hover,
.info-card:hover,
.service-card:hover,
.product-card:hover {
  border-color: rgba(226, 195, 153, 0.55);
}

.intro-band {
  background: var(--deep);
  border-block: 1px solid rgba(226, 195, 153, 0.1);
}
.plant-placeholder {
  color: var(--primary);
  background:
    linear-gradient(135deg, rgba(226,195,153,0.08), rgba(226,195,153,0.02)),
    repeating-linear-gradient(45deg, rgba(226,195,153,0.06) 0 12px, transparent 12px 24px);
  border-color: rgba(226, 195, 153, 0.32);
  border-radius: 0;
}
.plant-placeholder.dark {
  color: var(--primary);
  background:
    linear-gradient(135deg, rgba(226,195,153,0.11), rgba(226,195,153,0.03)),
    repeating-linear-gradient(45deg, rgba(226,195,153,0.08) 0 12px, transparent 12px 24px);
  border-color: rgba(226, 195, 153, 0.42);
}

.product-media {
  background: #333534;
  border-bottom: 1px solid rgba(226, 195, 153, 0.12);
}
.product-body h3,
.service-card h3,
.info-card h3,
.catalog-cta h3 {
  color: var(--white);
}
.pill,
.filter-button.active,
.filter-button:hover {
  color: var(--deep);
  background: var(--primary);
  border-color: var(--primary);
}
.filter-button {
  color: var(--muted);
  background: var(--surface);
  border-color: rgba(226, 195, 153, 0.2);
  border-radius: 0;
}
.catalog-cta {
  background: var(--surface);
  border-left: 2px solid var(--primary);
}
.service-card > span,
.service-card strong,
.detail-list strong,
label,
.contact-card strong {
  color: var(--primary);
}

.page-hero {
  padding: clamp(104px, 12vw, 168px) 0 clamp(66px, 8vw, 104px);
  background-image:
    linear-gradient(90deg, rgba(13,15,14,0.98), rgba(13,15,14,0.86) 54%, rgba(18,20,19,0.74)),
    radial-gradient(circle at 78% 16%, rgba(226,195,153,0.13), transparent 30%);
  border-bottom: 1px solid rgba(226, 195, 153, 0.16);
}
.page-hero h1 {
  color: var(--white);
  font-weight: 400;
}

.contact-card a,
.site-footer a {
  color: var(--muted);
}
.contact-card a:hover,
.site-footer a:hover {
  color: var(--primary);
}
input,
textarea {
  color: var(--white);
  background: transparent;
  border: 0;
  border-bottom: 1px solid rgba(209,197,184,0.42);
  border-radius: 0;
}
input:focus,
textarea:focus {
  border-bottom-color: var(--primary);
  outline: none;
}
.form-note {
  background: var(--deep);
  border-left-color: var(--primary);
}
.map {
  border-color: rgba(226,195,153,0.2);
  border-radius: 0;
}
.site-footer {
  background: var(--deep);
  border-top: 1px solid rgba(226,195,153,0.15);
}
.footer-grid {
  border-bottom-color: rgba(226,195,153,0.16);
}
.modal-backdrop { background: rgba(0,0,0,0.78); }
.modal-dialog {
  color: var(--white);
  background: var(--surface);
  border: 1px solid rgba(226,195,153,0.25);
  border-radius: 0;
}
.modal-close {
  color: var(--primary);
  background: var(--surface-high);
  border-color: rgba(226,195,153,0.25);
  border-radius: 0;
}
.modal-image { background: #333534; }

@media (max-width: 980px) {
  .hero-grid { min-height: calc(100svh - 168px); }
}

@media (max-width: 640px) {
  .container { width: min(100% - 28px, 88rem); }
  .hero {
    min-height: auto;
    padding-top: 112px;
    padding-bottom: 48px;
  }
  .hero-grid { min-height: auto; }
  .hero-copy h1 {
    font-size: clamp(2.45rem, 11vw, 3.45rem);
  }
  .metadata-grid {
    display: grid;
    align-items: start;
    justify-content: initial;
  }
}

